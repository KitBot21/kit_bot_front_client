{
  "expo": {
    "name": "kit_bot_front",
    "slug": "kit_bot_front",
    "owner": "haeramram",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "com.kumoh.kitbotfront",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kumoh.kitbotfront"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "package": "com.kumoh.kitbotfront",
      "googleServicesFile": "./google-services.json",
      "usesCleartextTraffic": true,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "com.kumoh.kitbotfront"
            }
          ]
        }
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      ["expo-web-browser", {}],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.358721642016-j5hcv6tjn6rvu04hk65qokap8hulhlgv"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "16375ed4-e45c-48a8-83a8-d808dd763926"
      }
    }
  }
}
